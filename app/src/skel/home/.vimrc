" vim on the machine. No swap or backup files: a write is one file, once.
set nocompatible
set noswapfile nobackup nowritebackup
set viminfo=
set nomodeline
set ttimeout ttimeoutlen=50
" No terminal queries (version, background, ambiguous width) and no bracketed paste.
set t_RV= t_u7= t_RB= t_BE=
set ruler showcmd laststatus=2
set incsearch hlsearch
set nowrap
